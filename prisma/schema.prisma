// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A grouping/aisle that bundles related voting options
// e.g. "Apparel & Fashion", "Food & Grocery", "Electronics"
model Section {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  name_i18n   Json     @default("{}")
  desc_i18n   Json     @default("{}")
  icon        String // lucide icon name
  color       String // tailwind color token: rose | amber | emerald | ...
  order       Int      @default(0)
  options     Option[]

  @@map("sections")
}

// A single voting category/option that users can tick.
// e.g. "Kids' Clothing", "Fresh Produce", "Smartphones"
model Option {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug        String   @unique
  name        String
  emoji       String
  imageUrl    String?
  description String
  name_i18n   Json     @default("{}")
  desc_i18n   Json     @default("{}")
  votes       Int      @default(0)
  order       Int      @default(0)
  isCustom    Boolean  @default(false) // true = added by a voter
  createdById String?  // Guest/creator identifier for CRUD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sectionId])
  @@index([createdById])
  @@map("options")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  votes     Vote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// One vote submission (a voter may tick multiple options).
// voterCount = count(Vote), totalVotes = sum(Option.votes)
model Vote {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip          String   // hashed IP for deduplication
  optionIds   String[] // which options this voter picked
  optionCount Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([ip])
  @@map("votes")
}
